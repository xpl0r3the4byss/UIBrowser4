<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="21701" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="21701"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ScriptGeneratorViewController" customModule="UIBrowser4" customModuleProvider="target">
            <connections>
                <outlet property="copyButton" destination="copy-btn" id="copy-out"/>
                <outlet property="includeCommentsCheckbox" destination="comments-check" id="comments-out"/>
                <outlet property="includeErrorHandlingCheckbox" destination="error-check" id="error-out"/>
                <outlet property="runButton" destination="run-btn" id="run-out"/>
                <outlet property="scriptTextView" destination="script-text" id="script-out"/>
                <outlet property="stylePopUpButton" destination="style-popup" id="style-out"/>
                <outlet property="timeoutTextField" destination="timeout-field" id="timeout-out"/>
                <outlet property="useNumericIndicesCheckbox" destination="indices-check" id="indices-out"/>
                <outlet property="view" destination="view-main" id="view-out"/>
                <outlet property="waitForElementCheckbox" destination="wait-check" id="wait-out"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="view-main">
            <rect key="frame" x="0.0" y="0.0" width="600" height="500"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <box title="Options" translatesAutoresizingMaskIntoConstraints="NO" id="options-box">
                    <rect key="frame" x="17" y="334" width="566" height="146"/>
                    <view key="contentView" id="options-content">
                        <rect key="frame" x="3" y="3" width="560" height="126"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="style-label">
                                <rect key="frame" x="18" y="90" width="80" height="16"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="76" id="style-label-width"/>
                                </constraints>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="Style:" id="style-label-cell">
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <popUpButton verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="style-popup">
                                <rect key="frame" x="102" y="85" width="200" height="25"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="200" id="style-popup-width"/>
                                </constraints>
                                <popUpButtonCell key="cell" type="push" title="System Events" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="style-item-1" id="style-cell">
                                    <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="system"/>
                                    <menu key="menu" id="style-menu">
                                        <items>
                                            <menuItem title="System Events" state="on" id="style-item-1"/>
                                            <menuItem title="AX Elements" id="style-item-2"/>
                                        </items>
                                    </menu>
                                </popUpButtonCell>
                                <connections>
                                    <action selector="styleChanged:" target="-2" id="style-action"/>
                                </connections>
                            </popUpButton>
                            <button translatesAutoresizingMaskIntoConstraints="NO" id="comments-check">
                                <rect key="frame" x="102" y="60" width="200" height="18"/>
                                <buttonCell key="cell" type="check" title="Include Comments" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="comments-cell">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                                <connections>
                                    <action selector="includeCommentsChanged:" target="-2" id="comments-action"/>
                                </connections>
                            </button>
                            <button translatesAutoresizingMaskIntoConstraints="NO" id="error-check">
                                <rect key="frame" x="102" y="35" width="200" height="18"/>
                                <buttonCell key="cell" type="check" title="Include Error Handling" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="error-cell">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                                <connections>
                                    <action selector="includeErrorHandlingChanged:" target="-2" id="error-action"/>
                                </connections>
                            </button>
                            <button translatesAutoresizingMaskIntoConstraints="NO" id="indices-check">
                                <rect key="frame" x="102" y="10" width="200" height="18"/>
                                <buttonCell key="cell" type="check" title="Use Numeric Indices" bezelStyle="regularSquare" imagePosition="left" inset="2" id="indices-cell">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                                <connections>
                                    <action selector="useNumericIndicesChanged:" target="-2" id="indices-action"/>
                                </connections>
                            </button>
                            <button translatesAutoresizingMaskIntoConstraints="NO" id="wait-check">
                                <rect key="frame" x="342" y="60" width="200" height="18"/>
                                <buttonCell key="cell" type="check" title="Wait for Element" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="wait-cell">
                                    <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="system"/>
                                </buttonCell>
                                <connections>
                                    <action selector="waitForElementChanged:" target="-2" id="wait-action"/>
                                </connections>
                            </button>
                            <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="timeout-label">
                                <rect key="frame" x="342" y="35" width="80" height="16"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="Timeout:" id="timeout-label-cell">
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <textField verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="timeout-field">
                                <rect key="frame" x="430" y="32" width="112" height="21"/>
                                <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" title="5.0" drawsBackground="YES" id="timeout-cell">
                                    <numberFormatter key="formatter" formatterBehavior="default10_4" numberStyle="decimal" minimumIntegerDigits="1" maximumIntegerDigits="2000000000" maximumFractionDigits="3" id="timeout-formatter"/>
                                    <font key="font" metaFont="system"/>
                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                                <connections>
                                    <action selector="timeoutChanged:" target="-2" id="timeout-action"/>
                                </connections>
                            </textField>
                        </subviews>
                        <constraints>
                            <constraint firstItem="style-label" firstAttribute="top" secondItem="options-content" secondAttribute="top" constant="20" id="style-label-top"/>
                            <constraint firstItem="style-label" firstAttribute="leading" secondItem="options-content" secondAttribute="leading" constant="20" id="style-label-left"/>
                            <constraint firstItem="style-popup" firstAttribute="centerY" secondItem="style-label" secondAttribute="centerY" id="style-popup-center"/>
                            <constraint firstItem="style-popup" firstAttribute="leading" secondItem="style-label" secondAttribute="trailing" constant="8" id="style-popup-left"/>
                            <constraint firstItem="comments-check" firstAttribute="top" secondItem="style-popup" secondAttribute="bottom" constant="12" id="comments-top"/>
                            <constraint firstItem="comments-check" firstAttribute="leading" secondItem="style-popup" secondAttribute="leading" id="comments-left"/>
                            <constraint firstItem="error-check" firstAttribute="top" secondItem="comments-check" secondAttribute="bottom" constant="12" id="error-top"/>
                            <constraint firstItem="error-check" firstAttribute="leading" secondItem="comments-check" secondAttribute="leading" id="error-left"/>
                            <constraint firstItem="indices-check" firstAttribute="top" secondItem="error-check" secondAttribute="bottom" constant="12" id="indices-top"/>
                            <constraint firstItem="indices-check" firstAttribute="leading" secondItem="error-check" secondAttribute="leading" id="indices-left"/>
                            <constraint firstItem="wait-check" firstAttribute="top" secondItem="style-popup" secondAttribute="bottom" constant="12" id="wait-top"/>
                            <constraint firstItem="wait-check" firstAttribute="leading" secondItem="comments-check" secondAttribute="trailing" constant="40" id="wait-left"/>
                            <constraint firstItem="timeout-label" firstAttribute="top" secondItem="wait-check" secondAttribute="bottom" constant="12" id="timeout-label-top"/>
                            <constraint firstItem="timeout-label" firstAttribute="leading" secondItem="wait-check" secondAttribute="leading" id="timeout-label-left"/>
                            <constraint firstItem="timeout-field" firstAttribute="centerY" secondItem="timeout-label" secondAttribute="centerY" id="timeout-field-center"/>
                            <constraint firstItem="timeout-field" firstAttribute="leading" secondItem="timeout-label" secondAttribute="trailing" constant="8" id="timeout-field-left"/>
                            <constraint firstAttribute="trailing" secondItem="timeout-field" secondAttribute="trailing" constant="20" id="timeout-field-right"/>
                        </constraints>
                    </view>
                </box>
                <scrollView horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="script-scroll">
                    <rect key="frame" x="20" y="61" width="560" height="265"/>
                    <clipView key="contentView" id="clip-view">
                        <rect key="frame" x="1" y="1" width="558" height="263"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textView importsGraphics="NO" verticallyResizable="YES" usesFontPanel="YES" findStyle="panel" allowsUndo="YES" usesRuler="YES" allowsNonContiguousLayout="YES" quoteSubstitution="YES" dashSubstitution="YES" spellingCorrection="YES" smartInsertDelete="YES" id="script-text">
                                <rect key="frame" x="0.0" y="0.0" width="558" height="263"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <size key="minSize" width="558" height="263"/>
                                <size key="maxSize" width="558" height="10000000"/>
                                <color key="insertionPointColor" name="textColor" catalog="System" colorSpace="catalog"/>
                            </textView>
                        </subviews>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="horz-scroll">
                        <rect key="frame" x="-100" y="-100" width="558" height="15"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <scroller key="verticalScroller" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="vert-scroll">
                        <rect key="frame" x="543" y="1" width="16" height="263"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                </scrollView>
                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="copy-btn">
                    <rect key="frame" x="398" y="13" width="82" height="32"/>
                    <buttonCell key="cell" type="push" title="Copy" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="copy-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="copyScript:" target="-2" id="copy-action"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="run-btn">
                    <rect key="frame" x="480" y="13" width="82" height="32"/>
                    <buttonCell key="cell" type="push" title="Run" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="run-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="runScript:" target="-2" id="run-action"/>
                    </connections>
                </button>
            </subviews>
            <constraints>
                <constraint firstItem="options-box" firstAttribute="top" secondItem="view-main" secondAttribute="top" constant="20" id="options-top"/>
                <constraint firstItem="options-box" firstAttribute="leading" secondItem="view-main" secondAttribute="leading" constant="20" id="options-left"/>
                <constraint firstAttribute="trailing" secondItem="options-box" secondAttribute="trailing" constant="20" id="options-right"/>
                <constraint firstItem="script-scroll" firstAttribute="top" secondItem="options-box" secondAttribute="bottom" constant="8" id="script-top"/>
                <constraint firstItem="script-scroll" firstAttribute="leading" secondItem="view-main" secondAttribute="leading" constant="20" id="script-left"/>
                <constraint firstAttribute="trailing" secondItem="script-scroll" secondAttribute="trailing" constant="20" id="script-right"/>
                <constraint firstItem="copy-btn" firstAttribute="top" secondItem="script-scroll" secondAttribute="bottom" constant="20" id="copy-top"/>
                <constraint firstItem="run-btn" firstAttribute="centerY" secondItem="copy-btn" secondAttribute="centerY" id="run-center"/>
                <constraint firstAttribute="trailing" secondItem="run-btn" secondAttribute="trailing" constant="40" id="run-right"/>
                <constraint firstItem="run-btn" firstAttribute="leading" secondItem="copy-btn" secondAttribute="trailing" constant="12" id="run-left"/>
                <constraint firstAttribute="bottom" secondItem="copy-btn" secondAttribute="bottom" constant="20" id="copy-bottom"/>
            </constraints>
            <point key="canvasLocation" x="139" y="154"/>
        </customView>
    </objects>
</document>