            <constraints>
                <constraint firstItem="path-ctrl" firstAttribute="top" secondItem="view-main" secondAttribute="top" constant="20" id="path-top"/>
                <constraint firstItem="path-ctrl" firstAttribute="leading" secondItem="view-main" secondAttribute="leading" constant="20" id="path-left"/>
                <constraint firstAttribute="trailing" secondItem="path-ctrl" secondAttribute="trailing" constant="20" id="path-right"/>
                <constraint firstItem="scroll" firstAttribute="top" secondItem="path-ctrl" secondAttribute="bottom" constant="20" id="scroll-top"/>
                <constraint firstItem="scroll" firstAttribute="leading" secondItem="view-main" secondAttribute="leading" constant="20" id="scroll-left"/>
                <constraint firstAttribute="trailing" secondItem="scroll" secondAttribute="trailing" constant="20" id="scroll-right"/>
