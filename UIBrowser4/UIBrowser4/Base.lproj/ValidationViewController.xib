                                    <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="rule-v-scroll"/>
                                    <tableHeaderView key="headerView" wantsLayer="YES" id="rule-header"/>
                                </scrollView>
