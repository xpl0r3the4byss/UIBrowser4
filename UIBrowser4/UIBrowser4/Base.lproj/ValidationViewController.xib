                                            <constraint firstItem="validate-btn" firstAttribute="centerY" secondItem="toolbar-content" secondAttribute="centerY" id="validate-center"/>
                                            <constraint firstItem="progress" firstAttribute="leading" secondItem="validate-btn" secondAttribute="trailing" constant="8" id="progress-left"/>
                                            <constraint firstItem="progress" firstAttribute="centerY" secondItem="validate-btn" secondAttribute="centerY" id="progress-center"/>
                                            <constraint firstAttribute="trailing" secondItem="export-btn" secondAttribute="trailing" constant="20" id="export-right"/>
                                            <constraint firstItem="export-btn" firstAttribute="centerY" secondItem="validate-btn" secondAttribute="centerY" id="export-center"/>
                                        </constraints>
                                    </view>
                                    <constraints>
                                        <constraint firstAttribute="height" constant="50" id="toolbar-height"/>
                                    </constraints>
                                </box>
