                                <constraint firstItem="rule-scroll" firstAttribute="leading" secondItem="left-pane" secondAttribute="leading" id="rule-left"/>
                                <constraint firstAttribute="trailing" secondItem="rule-scroll" secondAttribute="trailing" id="rule-right"/>
                                <constraint firstAttribute="bottom" secondItem="rule-scroll" secondAttribute="bottom" id="rule-bottom"/>
                            </constraints>
                        </customView>
                        <customView id="right-pane">
                            <rect key="frame" x="251" y="0.0" width="549" height="600"/>
                            <autoresizingMask key="autoresizingMask"/>
                            <subviews>
                                <box boxType="custom" borderType="none" title="Box" translatesAutoresizingMaskIntoConstraints="NO" id="toolbar">
                                    <rect key="frame" x="0.0" y="550" width="549" height="50"/>
                                    <view key="contentView" id="toolbar-content">
                                        <rect key="frame" x="0.0" y="0.0" width="549" height="50"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <subviews>
                                            <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="validate-btn">
                                                <rect key="frame" x="20" y="9" width="100" height="32"/>
                                                <buttonCell key="cell" type="push" title="Validate" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="validate-cell">
                                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                                    <font key="font" metaFont="system"/>
                                                </buttonCell>
                                                <connections>
                                                    <action selector="validateButtonClicked:" target="-2" id="validate-action"/>
                                                </connections>
                                            </button>
                                            <progressIndicator hidden="YES" wantsLayer="YES" horizontalHuggingPriority="750" verticalHuggingPriority="750" maxValue="100" displayedWhenStopped="NO" bezeled="NO" indeterminate="YES" controlSize="small" style="spinning" translatesAutoresizingMaskIntoConstraints="NO" id="progress">
                                                <rect key="frame" x="128" y="17" width="16" height="16"/>
                                            </progressIndicator>
                                            <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="export-btn">
                                                <rect key="frame" x="447" y="9" width="82" height="32"/>
                                                <buttonCell key="cell" type="push" title="Export" bezelStyle="rounded" alignment="center" enabled="NO" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="export-cell">
                                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                                    <font key="font" metaFont="system"/>
                                                </buttonCell>
                                                <connections>
